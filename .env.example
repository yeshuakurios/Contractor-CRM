# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.

# Neon connection string (Neon dashboard -> your project -> Connection Details)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random long random string, e.g. `openssl rand -hex 32` — used to sign session cookies
SESSION_SECRET=

# Set to a real value in production (Render sets NODE_ENV=production automatically)
NODE_ENV=development

# Google Places API (New) key — Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_PLACES_API_KEY=

# Anthropic API key (console.anthropic.com) — powers the website audit + mockup generation
ANTHROPIC_API_KEY=

# Stripe (dashboard.stripe.com -> Developers -> API keys). Test mode (sk_test_...)
# is fine until you're ready to accept real payments.
STRIPE_SECRET_KEY=

# From the webhook endpoint's "Signing secret" in Stripe -> Developers -> Webhooks
# (create the endpoint pointing at https://<your-app>/api/stripe/webhook first)
STRIPE_WEBHOOK_SECRET=

# Optional: overrides the base URL used in Checkout success/cancel redirects.
# Only needed if the app is reachable at a different URL than what the
# request itself reports (e.g. behind another proxy) — Render's default
# works without setting this.
# APP_BASE_URL=

# Filled in during a later build step:
# ENCRYPTION_KEY=
